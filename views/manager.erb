<!-- ========================================================================= -->
<!-- ANOTHER REDIS DESKTOP MANAGER INTERFACE (3 COLUNAS) -->
<!-- ========================================================================= -->

<!-- COLUNA 1: SERVIDORES & BANCOS DE DADOS (DB0 - DB15) -->
<aside class="w-64 bg-surface-900 border-r border-slate-800 flex flex-col shrink-0 select-none">
  <!-- Seletor de Conexão -->
  <div class="p-3 border-b border-slate-800 bg-surface-850">
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Servidor Ativo</span>
      <a href="/settings" class="text-[11px] text-brand-400 hover:text-brand-300 font-semibold">+ Novo</a>
    </div>
    <form action="/switch" method="get">
      <select name="server_id" onchange="this.form.submit()"
              class="w-full bg-slate-900 border border-slate-700 text-slate-100 text-xs font-semibold rounded-lg px-2.5 py-1.5 focus:ring-1 focus:ring-brand-500 focus:outline-none cursor-pointer truncate">
        <% @servers.each do |s| %>
          <option value="<%= s['id'] %>" <%= 'selected' if @current_server && s['id'] == @current_server['id'] %>>
            <%= h s['name'] %>
          </option>
        <% end %>
      </select>
    </form>
    <% if @current_server %>
      <div class="text-[10px] text-slate-400 font-mono mt-1 truncate">
        <%= h @current_server['host'] %>:<%= h @current_server['port'] %>
      </div>
    <% end %>
  </div>

  <!-- Lista de Bancos (DB0 a DB15) estilo ARDM -->
  <div class="flex-1 overflow-y-auto p-2 space-y-1">
    <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500 flex justify-between items-center">
      <span>Bancos de Dados (DBs)</span>
      <button onclick="refreshKeys()" class="hover:text-slate-300" title="Atualizar dados">🔄</button>
    </div>

    <% @databases.each do |db_item| %>
      <a href="/switch?server_id=<%= @current_server&.dig('id') %>&db=<%= db_item[:index] %>"
         class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all <%= db_item[:active] ? 'bg-brand-500/20 text-brand-300 border border-brand-500/30 font-semibold' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full <%= db_item[:keys_count] > 0 ? 'bg-emerald-400 shadow-sm shadow-emerald-400/50' : 'bg-slate-600' %>"></span>
          <span>db<%= db_item[:index] %></span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono <%= db_item[:keys_count] > 0 ? 'bg-slate-800 text-slate-300 font-bold' : 'text-slate-600' %>">
            <%= db_item[:keys_count] %>
          </span>
        </div>
      </a>
    <% end %>
  </div>

  <!-- Métricas Rápidas do Nó Ativo no Rodapé da Coluna 1 -->
  <% if @server_info %>
    <div class="p-3 bg-surface-850 border-t border-slate-800 text-[11px] text-slate-400 space-y-1 font-mono">
      <div class="flex justify-between">
        <span>Memória:</span>
        <span class="text-sky-400 font-bold"><%= h @server_info['used_memory_human'] %></span>
      </div>
      <div class="flex justify-between">
        <span>Clientes:</span>
        <span class="text-emerald-400"><%= h @server_info['connected_clients'] %></span>
      </div>
      <div class="flex justify-between">
        <span>Versão:</span>
        <span class="text-slate-300"><%= h @server_info['redis_version'] %></span>
      </div>
    </div>
  <% end %>
</aside>

<!-- COLUNA 2: LISTAGEM DE CHAVES (BUSCA, FILTRO, TTL) -->
<section class="w-80 bg-surface-950 border-r border-slate-800 flex flex-col shrink-0">
  <!-- Barra de Busca de Chaves estilo ARDM -->
  <div class="p-3 border-b border-slate-800 bg-surface-900/90 space-y-2">
    <div class="flex items-center gap-2">
      <div class="relative flex-1">
        <input type="text" id="searchPattern" placeholder="Buscar padrão (ex: * ou user:*)..."
               class="w-full bg-slate-900 border border-slate-700 text-slate-100 text-xs font-mono rounded-lg pl-7 pr-2.5 py-1.5 focus:ring-1 focus:ring-brand-500 focus:outline-none"
               onkeydown="if(event.key==='Enter') searchKeys()">
        <svg class="w-3.5 h-3.5 text-slate-500 absolute left-2 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <button onclick="searchKeys()" class="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-xs" title="Executar SCAN">
        🔍
      </button>
      <button onclick="openNewKeyModal()" class="px-2.5 py-1.5 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-lg text-xs flex items-center gap-1 shadow" title="Adicionar Nova Chave">
        +
      </button>
    </div>

    <!-- Filtro de Tipo e Contagem -->
    <div class="flex items-center justify-between text-[11px] text-slate-400">
      <span id="keysCountLabel">Carregando chaves...</span>
      <select id="typeFilter" onchange="filterKeysByType()" class="bg-slate-900 border border-slate-800 text-[11px] rounded px-1.5 py-0.5 text-slate-300 focus:outline-none">
        <option value="all">Todos os tipos</option>
        <option value="string">string</option>
        <option value="hash">hash</option>
        <option value="list">list</option>
        <option value="set">set</option>
        <option value="zset">zset</option>
      </select>
    </div>
  </div>

  <!-- Lista Scrollável de Chaves -->
  <div id="keysListContainer" class="flex-1 overflow-y-auto divide-y divide-slate-800/40 select-none">
    <!-- Inserido dinamicamente via JS -->
  </div>

  <!-- Paginação / SCAN Mais -->
  <div id="scanMoreBar" class="hidden p-2 border-t border-slate-800 bg-surface-900 text-center">
    <button onclick="loadMoreKeys()" class="text-xs text-brand-400 hover:text-brand-300 font-semibold">
      Carregar mais chaves (SCAN &darr;)
    </button>
  </div>
</section>

<!-- COLUNA 3: VISUALIZADOR & EDITOR DE CHAVE (CONTEÚDO, TTL, TIPO, FORMATADOR JSON) -->
<main class="flex-1 bg-surface-900 flex flex-col overflow-hidden">
  
  <!-- Empty State Quando Nenhuma Chave Está Selecionada -->
  <div id="emptyKeyDetails" class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-500">
    <div class="w-16 h-16 rounded-2xl bg-surface-800/80 border border-slate-700/50 flex items-center justify-center text-3xl mb-4 shadow-inner">
      🗄️
    </div>
    <h3 class="text-base font-bold text-slate-300 mb-1">Nenhuma Chave Selecionada</h3>
    <p class="text-xs max-w-sm text-slate-400">
      Selecione uma chave na lista à esquerda para inspecionar, editar seu conteúdo ou gerenciar seu tempo de expiração (TTL).
    </p>
  </div>

  <!-- Painel Ativo de Detalhes da Chave -->
  <div id="activeKeyDetails" class="hidden flex-1 flex flex-col overflow-hidden">
    <!-- Top Bar da Chave -->
    <div class="p-4 border-b border-slate-800 bg-surface-850 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <!-- Badge de Tipo -->
        <span id="detailBadgeType" class="px-2 py-0.5 rounded text-[11px] font-bold uppercase border">
          STRING
        </span>
        <!-- Nome da Chave e Ação de Renomear -->
        <div class="flex items-center gap-2 min-w-0">
          <span id="detailKeyName" class="text-base font-mono font-bold text-white truncate max-w-md"></span>
          <button onclick="promptRenameKey()" class="text-xs text-slate-400 hover:text-white" title="Renomear Chave">✏️</button>
        </div>
      </div>

      <!-- Ações: Atualizar, Salvar, Excluir -->
      <div class="flex items-center gap-2">
        <button onclick="refreshActiveKey()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all">
          🔄 Recarregar
        </button>
        <button onclick="saveCurrentKeyContent()" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow transition-all">
          💾 Salvar Alterações
        </button>
        <button onclick="deleteCurrentKey()" class="px-3 py-1.5 bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/30 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all">
          🗑️ Excluir
        </button>
      </div>
    </div>

    <!-- Barra de Metadados: TTL, Tamanho, Formato -->
    <div class="px-4 py-2.5 bg-surface-900 border-b border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
      <div class="flex items-center gap-6">
        <!-- Editor de TTL inline -->
        <div class="flex items-center gap-2">
          <span class="text-slate-400">TTL:</span>
          <div class="flex items-center gap-1">
            <input type="number" id="detailTtlInput" class="w-24 bg-slate-950 border border-slate-700 rounded px-2 py-0.5 text-xs text-amber-300 font-bold focus:ring-1 focus:ring-brand-500 focus:outline-none">
            <span class="text-slate-400 text-[11px]">s</span>
            <button onclick="updateTtl()" class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded border border-slate-700 text-[11px]" title="Salvar novo TTL">
              OK
            </button>
          </div>
          <span id="detailTtlHuman" class="text-slate-500 text-[11px]"></span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-slate-400">Elementos / Comprimento:</span>
          <span id="detailLength" class="text-slate-200 font-bold"></span>
        </div>

        <div class="flex items-center gap-2" id="detailMemoryBox">
          <span class="text-slate-400">Memória Usada:</span>
          <span id="detailMemory" class="text-sky-400"></span>
        </div>
      </div>

      <!-- Formatadores Rápidos -->
      <div class="flex items-center gap-2 font-sans">
        <span class="text-slate-400 text-[11px]">Exibir como:</span>
        <button onclick="setViewMode('raw')" id="btnViewRaw" class="px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-800 text-slate-200 border border-slate-700">Raw</button>
        <button onclick="setViewMode('json')" id="btnViewJson" class="px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-900 text-slate-400 hover:text-slate-200">JSON Format</button>
      </div>
    </div>

    <!-- Área de Conteúdo / Editor -->
    <div class="flex-1 p-4 overflow-hidden flex flex-col">
      <!-- Editor para String -->
      <div id="stringEditorContainer" class="flex-1 flex flex-col">
        <textarea id="stringContentArea" 
                  class="flex-1 w-full bg-slate-950 border border-slate-800 rounded-xl p-4 font-mono text-xs text-slate-200 focus:ring-1 focus:ring-brand-500 focus:outline-none resize-none leading-relaxed"></textarea>
      </div>

      <!-- Tabela / Lista para Estruturas Complexas (Hash, List, Set, ZSet) -->
      <div id="complexEditorContainer" class="hidden flex-1 flex flex-col overflow-hidden bg-slate-950 border border-slate-800 rounded-xl">
        <div class="overflow-x-auto flex-1">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-slate-900/80 text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-800 sticky top-0">
              <tr>
                <th class="px-4 py-2.5 font-bold" id="complexCol1">Campo / Índice</th>
                <th class="px-4 py-2.5 font-bold" id="complexCol2">Valor</th>
              </tr>
            </thead>
            <tbody id="complexTableBody" class="divide-y divide-slate-800/60">
              <!-- Renderizado via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</main>

<!-- MODAL: NOVA CHAVE (ARDM STYLE) -->
<div id="modalNewKey" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-surface-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        ➕ Criar Nova Chave (db<%= @active_db %>)
      </h3>
      <button onclick="closeNewKeyModal()" class="text-slate-400 hover:text-white">&times;</button>
    </div>

    <form onsubmit="handleCreateKey(event)" class="space-y-4">
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Nome da Chave</label>
        <input type="text" id="newKeyName" required placeholder="ex: usuario:1001 ou config:app" 
               class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-white focus:ring-1 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Tipo de Dado</label>
          <select id="newKeyType" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-white focus:ring-1 focus:ring-brand-500 focus:outline-none">
            <option value="string">string</option>
            <option value="hash">hash</option>
            <option value="list">list</option>
            <option value="set">set</option>
            <option value="zset">zset</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">TTL (Segundos, opcional)</label>
          <input type="number" id="newKeyTtl" placeholder="ex: 3600 (vazio = permanente)" 
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-white focus:ring-1 focus:ring-brand-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Conteúdo Inicial / Valor</label>
        <textarea id="newKeyValue" rows="4" placeholder="Insira o texto, JSON ou valor inicial..."
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-white focus:ring-1 focus:ring-brand-500 focus:outline-none"></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeNewKeyModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold">Cancelar</button>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-lg text-xs font-semibold shadow">Criar Chave</button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================================================= -->
<!-- JAVASCRIPT CLIENTE: ARDM CORE ENGINE -->
<!-- ========================================================================= -->
<script>
  let currentKeys = [];
  let selectedKeyData = null;
  let viewMode = 'raw'; // 'raw' ou 'json'
  let nextCursor = '0';

  // Inicialização
  document.addEventListener('DOMContentLoaded', () => {
    searchKeys();
  });

  // 1. Carregar chaves via API com busca e filtro
  async function searchKeys() {
    const pattern = document.getElementById('searchPattern').value.trim() || '*';
    const container = document.getElementById('keysListContainer');
    const label = document.getElementById('keysCountLabel');
    
    label.textContent = 'Carregando...';
    container.innerHTML = '<div class="p-4 text-center text-xs text-slate-500">Escaneando chaves no Redis...</div>';

    try {
      const res = await fetch(`/api/keys?pattern=${encodeURIComponent(pattern)}&cursor=0`);
      const data = await res.json();

      if (data.error) {
        container.innerHTML = `<div class="p-4 text-xs text-red-400">${data.error}</div>`;
        label.textContent = 'Erro';
        return;
      }

      currentKeys = data.keys || [];
      nextCursor = data.cursor;

      renderKeysList();
      label.textContent = `${currentKeys.length} chaves encontradas`;

      const moreBar = document.getElementById('scanMoreBar');
      if (nextCursor !== '0') {
        moreBar.classList.remove('hidden');
      } else {
        moreBar.classList.add('hidden');
      }
    } catch (err) {
      container.innerHTML = `<div class="p-4 text-xs text-red-400">Falha na requisição: ${err.message}</div>`;
      label.textContent = 'Erro';
    }
  }

  // 2. Renderizar lista de chaves na Coluna 2
  function renderKeysList() {
    const container = document.getElementById('keysListContainer');
    const filter = document.getElementById('typeFilter').value;

    const filtered = filter === 'all' 
      ? currentKeys 
      : currentKeys.filter(k => k.type === filter);

    if (filtered.length === 0) {
      container.innerHTML = '<div class="p-4 text-center text-xs text-slate-500">Nenhuma chave encontrada com este filtro.</div>';
      return;
    }

    container.innerHTML = filtered.map(k => {
      const typeColor = getTypeColor(k.type);
      const isSelected = selectedKeyData && selectedKeyData.name === k.name;
      const ttlLabel = k.ttl === -1 ? '∞' : (k.ttl === -2 ? 'exp' : `${k.ttl}s`);

      return `
        <div onclick="selectKey('${escapeHtml(k.name)}')" 
             class="px-3 py-2 flex items-center justify-between cursor-pointer transition-colors ${isSelected ? 'bg-brand-500/15 border-l-2 border-brand-500' : 'hover:bg-slate-900'}">
          <div class="flex items-center gap-2 min-w-0 pr-2">
            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase border ${typeColor}">
              ${k.type}
            </span>
            <span class="text-xs font-mono text-slate-200 truncate ${isSelected ? 'font-bold text-brand-300' : ''}">
              ${escapeHtml(k.name)}
            </span>
          </div>
          <span class="text-[10px] font-mono text-slate-500 shrink-0">
            ${ttlLabel}
          </span>
        </div>
      `;
    }).join('');
  }

  function filterKeysByType() {
    renderKeysList();
  }

  // 3. Selecionar e carregar chave detalhada (Coluna 3)
  async function selectKey(name) {
    try {
      const res = await fetch(`/api/key?name=${encodeURIComponent(name)}`);
      const data = await res.json();

      if (data.error) {
        alert(data.error);
        return;
      }

      selectedKeyData = data;
      renderKeysList(); // atualiza item selecionado
      displayKeyDetails(data);
    } catch (err) {
      alert('Erro ao carregar detalhes: ' + err.message);
    }
  }

  // 4. Exibir detalhes na tela
  function displayKeyDetails(data) {
    document.getElementById('emptyKeyDetails').classList.add('hidden');
    document.getElementById('activeKeyDetails').classList.remove('hidden');

    document.getElementById('detailKeyName').textContent = data.name;
    document.getElementById('detailTtlInput').value = data.ttl;
    document.getElementById('detailLength').textContent = data.length;

    const ttlHuman = data.ttl === -1 
      ? 'Persistente (sem expiração)' 
      : (data.ttl === -2 ? 'Expirada' : `Expira em ~${Math.round(data.ttl / 60)} min`);
    document.getElementById('detailTtlHuman').textContent = ttlHuman;

    const badge = document.getElementById('detailBadgeType');
    badge.textContent = data.type.toUpperCase();
    badge.className = `px-2 py-0.5 rounded text-[11px] font-bold uppercase border ${getTypeColor(data.type)}`;

    if (data.memory_usage) {
      document.getElementById('detailMemoryBox').classList.remove('hidden');
      document.getElementById('detailMemory').textContent = `${data.memory_usage} bytes`;
    } else {
      document.getElementById('detailMemoryBox').classList.add('hidden');
    }

    // Renderizar conteúdo de acordo com o tipo
    const stringBox = document.getElementById('stringEditorContainer');
    const complexBox = document.getElementById('complexEditorContainer');

    if (data.type === 'string') {
      stringBox.classList.remove('hidden');
      complexBox.classList.add('hidden');
      renderStringContent(data.value);
    } else {
      stringBox.classList.add('hidden');
      complexBox.classList.remove('hidden');
      renderComplexContent(data.type, data.value);
    }
  }

  function renderStringContent(val) {
    const area = document.getElementById('stringContentArea');
    if (viewMode === 'json') {
      try {
        const obj = JSON.parse(val);
        area.value = JSON.stringify(obj, null, 2);
      } catch (e) {
        area.value = val || '';
      }
    } else {
      area.value = val || '';
    }
  }

  function renderComplexContent(type, val) {
    const tbody = document.getElementById('complexTableBody');
    const col1 = document.getElementById('complexCol1');
    const col2 = document.getElementById('complexCol2');

    tbody.innerHTML = '';

    if (type === 'hash') {
      col1.textContent = 'Campo (Key)';
      col2.textContent = 'Valor (Value)';
      if (val && typeof val === 'object') {
        Object.entries(val).forEach(([k, v]) => {
          tbody.innerHTML += `
            <tr class="hover:bg-slate-900/50">
              <td class="px-4 py-2 text-sky-400 font-bold">${escapeHtml(k)}</td>
              <td class="px-4 py-2 text-slate-300 break-all">${escapeHtml(v)}</td>
            </tr>
          `;
        });
      }
    } else if (type === 'list' || type === 'set') {
      col1.textContent = '# Índice';
      col2.textContent = 'Elemento';
      if (Array.isArray(val)) {
        val.forEach((item, idx) => {
          tbody.innerHTML += `
            <tr class="hover:bg-slate-900/50">
              <td class="px-4 py-2 text-slate-500 font-bold">${idx}</td>
              <td class="px-4 py-2 text-slate-300 break-all">${escapeHtml(item)}</td>
            </tr>
          `;
        });
      }
    } else if (type === 'zset') {
      col1.textContent = 'Score';
      col2.textContent = 'Membro (Member)';
      if (Array.isArray(val)) {
        val.forEach(([member, score]) => {
          tbody.innerHTML += `
            <tr class="hover:bg-slate-900/50">
              <td class="px-4 py-2 text-amber-400 font-bold">${score}</td>
              <td class="px-4 py-2 text-slate-300 break-all">${escapeHtml(member)}</td>
            </tr>
          `;
        });
      }
    }
  }

  function setViewMode(mode) {
    viewMode = mode;
    document.getElementById('btnViewRaw').className = mode === 'raw' 
      ? 'px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-800 text-slate-200 border border-slate-700' 
      : 'px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-900 text-slate-400 hover:text-slate-200';

    document.getElementById('btnViewJson').className = mode === 'json' 
      ? 'px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-800 text-slate-200 border border-slate-700' 
      : 'px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-900 text-slate-400 hover:text-slate-200';

    if (selectedKeyData && selectedKeyData.type === 'string') {
      renderStringContent(selectedKeyData.value);
    }
  }

  // 5. Salvar Conteúdo da Chave
  async function saveCurrentKeyContent() {
    if (!selectedKeyData) return;

    let payload = {
      name: selectedKeyData.name,
      type: selectedKeyData.type
    };

    if (selectedKeyData.type === 'string') {
      payload.value = document.getElementById('stringContentArea').value;
    } else {
      alert('Edição rápida direta suportada para Strings. Para outras estruturas, use o CLI ou adicione elementos.');
      return;
    }

    try {
      const res = await fetch('/api/key/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        alert('Chave gravada com sucesso!');
        refreshActiveKey();
      } else {
        alert('Erro ao salvar: ' + data.error);
      }
    } catch (err) {
      alert('Falha na requisição: ' + err.message);
    }
  }

  // 6. Atualizar TTL
  async function updateTtl() {
    if (!selectedKeyData) return;
    const ttl = parseInt(document.getElementById('detailTtlInput').value, 10);

    try {
      const res = await fetch('/api/key/ttl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: selectedKeyData.name, ttl: ttl })
      });
      const data = await res.json();
      if (data.success) {
        alert('TTL atualizado com sucesso!');
        refreshActiveKey();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Falha ao atualizar TTL: ' + err.message);
    }
  }

  // 7. Renomear Chave
  async function promptRenameKey() {
    if (!selectedKeyData) return;
    const newName = prompt('Novo nome para a chave:', selectedKeyData.name);
    if (!newName || newName === selectedKeyData.name) return;

    try {
      const res = await fetch('/api/key/rename', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ old_name: selectedKeyData.name, new_name: newName })
      });
      const data = await res.json();
      if (data.success) {
        searchKeys();
        selectKey(newName);
      } else {
        alert('Erro ao renomear: ' + data.error);
      }
    } catch (err) {
      alert('Falha: ' + err.message);
    }
  }

  // 8. Excluir Chave
  async function deleteCurrentKey() {
    if (!selectedKeyData) return;
    if (!confirm(`Confirma a exclusão definitiva da chave "${selectedKeyData.name}"?`)) return;

    try {
      const res = await fetch('/api/key/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: selectedKeyData.name })
      });
      const data = await res.json();
      if (data.success) {
        selectedKeyData = null;
        document.getElementById('emptyKeyDetails').classList.remove('hidden');
        document.getElementById('activeKeyDetails').classList.add('hidden');
        searchKeys();
      } else {
        alert('Erro ao excluir: ' + data.error);
      }
    } catch (err) {
      alert('Falha: ' + err.message);
    }
  }

  function refreshActiveKey() {
    if (selectedKeyData) {
      selectKey(selectedKeyData.name);
    }
  }

  function refreshKeys() {
    searchKeys();
  }

  // 9. Modal Criar Chave
  function openNewKeyModal() {
    document.getElementById('modalNewKey').classList.remove('hidden');
  }

  function closeNewKeyModal() {
    document.getElementById('modalNewKey').classList.add('hidden');
  }

  async function handleCreateKey(e) {
    e.preventDefault();
    const name = document.getElementById('newKeyName').value.trim();
    const type = document.getElementById('newKeyType').value;
    const ttl = document.getElementById('newKeyTtl').value;
    const value = document.getElementById('newKeyValue').value;

    try {
      const res = await fetch('/api/key/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, type, ttl, value })
      });
      const data = await res.json();
      if (data.success) {
        closeNewKeyModal();
        searchKeys();
        selectKey(name);
      } else {
        alert('Erro ao criar: ' + data.error);
      }
    } catch (err) {
      alert('Falha: ' + err.message);
    }
  }

  function getTypeColor(type) {
    switch (type) {
      case 'string': return 'bg-blue-500/10 text-blue-400 border-blue-500/20';
      case 'hash': return 'bg-purple-500/10 text-purple-400 border-purple-500/20';
      case 'list': return 'bg-pink-500/10 text-pink-400 border-pink-500/20';
      case 'set': return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
      case 'zset': return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
      default: return 'bg-slate-800 text-slate-400 border-slate-700';
    }
  }

  function escapeHtml(text) {
    if (!text) return '';
    return String(text)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
