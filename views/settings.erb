<div class="flex-1 p-6 md:p-8 overflow-y-auto max-w-7xl mx-auto w-full">
  <!-- Cabeçalho da Página de Configurações -->
  <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-6 border-b border-slate-800 gap-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
        Configurações de Conexões Redis (SQLite3)
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        Cadastre os servidores, portas, senhas e parâmetros de conexão.
      </p>
    </div>
    <div>
      <a href="/" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-surface-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all">
        &larr; Voltar para o Explorer Manager
      </a>
    </div>
  </div>

  <!-- Mensagens Flash -->
  <% if @flash %>
    <div class="mb-6 p-4 rounded-xl text-xs flex items-center gap-3 border shadow-sm <%= @flash[:type] == 'success' ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-300' : 'bg-blue-500/10 border-blue-500/20 text-blue-300' %>">
      <span><%= h @flash[:text] %></span>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

    <!-- Formulário de Cadastro / Edição -->
    <div class="lg:col-span-5">
      <div class="bg-surface-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <%= @edit_server ? '✏️ Editar Servidor' : '➕ Novo Servidor Redis' %>
          </h3>
          <% if @edit_server %>
            <a href="/settings" class="text-xs text-brand-400 hover:underline">Cancelar Edição</a>
          <% end %>
        </div>

        <form action="<%= @edit_server ? '/settings/update' : '/settings/create' %>" method="post" id="serverForm">
          <% if @edit_server %>
            <input type="hidden" name="id" value="<%= @edit_server['id'] %>">
          <% end %>

          <!-- Nome Amigável -->
          <div class="mb-3">
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
              Nome Amigável
            </label>
            <input type="text" name="name" value="<%= h @edit_server&.dig('name') %>" required
                   placeholder="Ex: Redis HML DETRAN-BA, Cache Prod"
                   class="w-full bg-slate-950 text-slate-100 border border-slate-700 rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-brand-500 focus:outline-none">
          </div>

          <!-- Host e Porta -->
          <div class="grid grid-cols-3 gap-3 mb-3">
            <div class="col-span-2">
              <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
                Host / IP / DNS
              </label>
              <input type="text" name="host" id="inputHost" value="<%= h @edit_server&.dig('host') %>" required
                     placeholder="ex: redis-hml.apps.ocp-prod..."
                     class="w-full bg-slate-950 text-slate-100 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono focus:ring-1 focus:ring-brand-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
                Porta
              </label>
              <input type="number" name="port" id="inputPort" value="<%= @edit_server&.dig('port') || 6379 %>" required
                     class="w-full bg-slate-950 text-slate-100 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono focus:ring-1 focus:ring-brand-500 focus:outline-none">
            </div>
          </div>

          <!-- Senha -->
          <div class="mb-3">
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
              Senha (AUTH / Requirepass)
            </label>
            <div class="relative">
              <input type="password" name="password" id="inputPassword" value="<%= h @edit_server&.dig('password') %>"
                     placeholder="Deixe em branco se não houver senha"
                     class="w-full bg-slate-950 text-slate-100 border border-slate-700 rounded-xl px-3 py-2 pr-10 text-xs font-mono focus:ring-1 focus:ring-brand-500 focus:outline-none">
              <button type="button" onclick="togglePassVisibility()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-200">
                👁️
              </button>
            </div>
          </div>

          <!-- Banco e SSL -->
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div>
              <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
                DB Index Padrão (0-15)
              </label>
              <input type="number" name="db" id="inputDb" min="0" max="15" value="<%= @edit_server&.dig('db') || 0 %>"
                     class="w-full bg-slate-950 text-slate-100 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono focus:ring-1 focus:ring-brand-500 focus:outline-none">
            </div>
            <div class="flex items-center pt-5">
              <label class="inline-flex items-center cursor-pointer">
                <input type="checkbox" name="ssl" id="inputSsl" value="true" <%= 'checked' if @edit_server&.dig('ssl') %>
                       class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-brand-600 focus:ring-brand-500">
                <span class="ml-2 text-xs font-semibold text-slate-300">Conexão TLS/SSL</span>
              </label>
            </div>
          </div>

          <div id="testResult" class="hidden mb-4 p-3 rounded-xl text-xs border"></div>

          <div class="flex flex-col sm:flex-row items-center gap-2">
            <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-500 text-white shadow transition-all text-center">
              <%= @edit_server ? 'Salvar Alterações' : 'Adicionar Servidor' %>
            </button>
            <button type="button" onclick="testCurrentConfig()" id="btnTestConn" class="w-full py-2 px-3 rounded-xl text-xs font-semibold bg-surface-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all text-center">
              🔌 Testar Conexão
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabela de Servidores Cadastrados -->
    <div class="lg:col-span-7">
      <div class="bg-surface-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="px-5 py-3 border-b border-slate-800 bg-surface-850">
          <h3 class="text-sm font-bold text-white">Servidores no Banco SQLite3</h3>
          <p class="text-[11px] text-slate-400">Total de <%= @servers.size %> conexões armazenadas</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950/40 text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
              <tr>
                <th class="px-4 py-2.5 font-semibold">Nome</th>
                <th class="px-4 py-2.5 font-semibold">Host : Porta</th>
                <th class="px-4 py-2.5 font-semibold">Senha</th>
                <th class="px-4 py-2.5 font-semibold text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% @servers.each do |s| %>
                <tr class="hover:bg-slate-800/30 transition-colors">
                  <td class="px-4 py-3">
                    <div class="font-semibold text-white"><%= h s['name'] %></div>
                  </td>
                  <td class="px-4 py-3 font-mono text-slate-300">
                    <%= h s['host'] %>:<%= h s['port'] %>
                  </td>
                  <td class="px-4 py-3">
                    <% if s['password'] && !s['password'].empty? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Senha Salva
                      </span>
                    <% else %>
                      <span class="text-slate-500 text-[11px]">Nenhuma</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-right space-x-2">
                    <a href="/switch?server_id=<%= s['id'] %>&return_to=/" class="text-xs font-semibold text-brand-400 hover:text-brand-300">
                      Abrir
                    </a>
                    <a href="/settings?edit_id=<%= s['id'] %>" class="text-xs text-slate-400 hover:text-white">
                      Editar
                    </a>
                    <form action="/settings/delete" method="post" class="inline" onsubmit="return confirm('Excluir <%= h s['name'] %>?');">
                      <input type="hidden" name="id" value="<%= s['id'] %>">
                      <button type="submit" class="text-xs text-red-400 hover:text-red-300">
                        Excluir
                      </button>
                    </form>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function togglePassVisibility() {
    const el = document.getElementById('inputPassword');
    el.type = el.type === 'password' ? 'text' : 'password';
  }

  async function testCurrentConfig() {
    const btn = document.getElementById('btnTestConn');
    const resultBox = document.getElementById('testResult');
    const host = document.getElementById('inputHost').value.trim();
    const port = document.getElementById('inputPort').value.trim();
    const password = document.getElementById('inputPassword').value;
    const db = document.getElementById('inputDb').value.trim();
    const ssl = document.getElementById('inputSsl').checked;

    if (!host) {
      alert('Informe o Host antes de testar.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Testando...';
    resultBox.className = 'mb-4 p-3 rounded-xl text-xs border bg-slate-800 text-slate-300 border-slate-700 block';
    resultBox.textContent = 'Enviando comando PING ao Redis...';

    try {
      const res = await fetch('/settings/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ host, port, password, db, ssl })
      });
      const data = await res.json();

      if (data.success) {
        resultBox.className = 'mb-4 p-3 rounded-xl text-xs border bg-emerald-500/10 border-emerald-500/30 text-emerald-300 block';
        resultBox.textContent = '✅ ' + data.message;
      } else {
        resultBox.className = 'mb-4 p-3 rounded-xl text-xs border bg-red-500/10 border-red-500/30 text-red-300 block';
        resultBox.textContent = '❌ Erro de conexão: ' + data.message;
      }
    } catch (err) {
      resultBox.className = 'mb-4 p-3 rounded-xl text-xs border bg-red-500/10 border-red-500/30 text-red-300 block';
      resultBox.textContent = '❌ Erro na requisição: ' + err.message;
    } finally {
      btn.disabled = false;
      btn.textContent = '🔌 Testar Conexão';
    }
  }
</script>
