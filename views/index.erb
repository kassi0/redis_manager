<div class="page-header">
  <div>
    <h1>Painel de Controle</h1>
    <p class="subtitle">Visão geral do nó Redis selecionado: <span class="highlight"><%= h @selected_server %></span></p>
  </div>
  <div>
    <a href="/?server=<%= Rack::Utils.escape(@selected_server) %>" class="btn btn-secondary">🔄 Atualizar</a>
  </div>
</div>

<% if @info %>
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-title">Status da Conexão</div>
      <div class="metric-value status-online">● <%= @ping == 'PONG' ? 'Online (PONG)' : 'Instável' %></div>
      <div class="metric-footer">Versão Redis: <%= h @info['redis_version'] %></div>
    </div>

    <div class="metric-card">
      <div class="metric-title">Total de Chaves (DBSize)</div>
      <div class="metric-value"><%= @db_size %></div>
      <div class="metric-footer">Modo: <%= h @info['redis_mode'] || 'standalone' %></div>
    </div>

    <div class="metric-card">
      <div class="metric-title">Memória Alocada</div>
      <div class="metric-value"><%= h @info['used_memory_human'] %></div>
      <div class="metric-footer">Pico: <%= h @info['used_memory_peak_human'] %></div>
    </div>

    <div class="metric-card">
      <div class="metric-title">Clientes Conectados</div>
      <div class="metric-value"><%= h @info['connected_clients'] %></div>
      <div class="metric-footer">Bloqueados: <%= h @info['blocked_clients'] %></div>
    </div>

    <div class="metric-card">
      <div class="metric-title">Uptime</div>
      <div class="metric-value"><%= (@info['uptime_in_seconds'].to_i / 3600.0).round(1) %> hrs</div>
      <div class="metric-footer"><%= h @info['uptime_in_days'] %> dias corridos</div>
    </div>

    <div class="metric-card">
      <div class="metric-title">Operações / seg (Ops/sec)</div>
      <div class="metric-value"><%= h @info['instantaneous_ops_per_sec'] %></div>
      <div class="metric-footer">Total conexões: <%= h @info['total_connections_received'] %></div>
    </div>
  </div>

  <div class="card-section">
    <h2>Informações Detalhadas do Servidor</h2>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Propriedade</th>
            <th>Valor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Função (Role)</strong></td>
            <td><span class="badge badge-info"><%= h @info['role']&.upcase %></span></td>
          </tr>
          <tr>
            <td><strong>PID do Processo</strong></td>
            <td><%= h @info['process_id'] %></td>
          </tr>
          <tr>
            <td><strong>SO do Host</strong></td>
            <td><%= h @info['os'] %></td>
          </tr>
          <tr>
            <td><strong>Taxa de Acertos de Cache (Hit Rate)</strong></td>
            <td>
              <% 
                hits = @info['keyspace_hits'].to_f
                misses = @info['keyspace_misses'].to_f
                total = hits + misses
                rate = total > 0 ? ((hits / total) * 100).round(2) : 0
              %>
              <%= rate %>% (<%= hits.to_i %> hits / <%= misses.to_i %> misses)
            </td>
          </tr>
          <tr>
            <td><strong>Fragmentação de Memória</strong></td>
            <td><%= h @info['mem_fragmentation_ratio'] %></td>
          </tr>
          <tr>
            <td><strong>Uso de CPU (System / User)</strong></td>
            <td><%= h @info['used_cpu_sys'] %>s / <%= h @info['used_cpu_user'] %>s</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="empty-state">
    <h3>Nenhum dado recebido</h3>
    <p>Verifique se o endpoint Redis está acessível pelo pod ou rede local.</p>
  </div>
<% end %>
