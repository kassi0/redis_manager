<div class="flex flex-col md:flex-row md:items-center justify-between pb-8 mb-8 border-b border-slate-800 gap-4">
  <div>
    <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
      Explorador de Chaves (Keyspace)
    </h2>
    <p class="text-sm text-slate-400 mt-1">
      Buscando no nó ativo: <span class="text-brand-400 font-semibold"><%= h @current_server&.dig('name') %></span>
    </p>
  </div>
  <div>
    <button onclick="document.getElementById('newKeyModal').classList.toggle('hidden')" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-brand-600 hover:bg-brand-500 text-white shadow-lg shadow-brand-600/20 transition-all">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      Nova Chave
    </button>
  </div>
</div>

<!-- Modal Adicionar Chave -->
<div id="newKeyModal" class="hidden mb-8 bg-surface-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
  <h3 class="text-base font-bold text-white mb-4">Gravar Chave no Redis</h3>
  <form action="/keys/set" method="post" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Chave (Key)</label>
        <input type="text" name="key" required placeholder="ex: usuario:1001:sessao" 
               class="w-full bg-slate-900 text-slate-100 border border-slate-700 rounded-xl px-3.5 py-2 text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">TTL em Segundos (Opcional)</label>
        <input type="number" name="ttl" placeholder="ex: 3600 (vazio = permanente)" 
               class="w-full bg-slate-900 text-slate-100 border border-slate-700 rounded-xl px-3.5 py-2 text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Valor (String / JSON)</label>
      <textarea name="value" rows="3" required placeholder="Digite o payload ou string..."
                class="w-full bg-slate-900 text-slate-100 border border-slate-700 rounded-xl px-3.5 py-2 text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:outline-none"></textarea>
    </div>
    <div class="flex gap-3">
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-sm font-semibold transition-all">Gravar no Redis</button>
      <button type="button" onclick="document.getElementById('newKeyModal').classList.add('hidden')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-semibold transition-all">Cancelar</button>
    </div>
  </form>
</div>

<!-- Filtro SCAN -->
<div class="mb-6 flex gap-3">
  <form action="/keys" method="get" class="flex gap-3 w-full max-w-xl">
    <div class="relative flex-1">
      <input type="text" name="pattern" value="<%= h @pattern %>" placeholder="Filtro (ex: session:*, cache:*, user:*)" 
             class="w-full bg-surface-900 text-slate-100 border border-slate-800 rounded-xl px-4 py-2.5 text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:outline-none">
    </div>
    <button type="submit" class="px-4 py-2.5 bg-surface-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl text-sm font-semibold transition-all flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      SCAN
    </button>
  </form>
</div>

<!-- Tabela de Chaves -->
<div class="bg-surface-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-950/40 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
      <tr>
        <th class="px-5 py-3 font-semibold">Chave (Key Name)</th>
        <th class="px-5 py-3 font-semibold">Tipo</th>
        <th class="px-5 py-3 font-semibold">Tempo de Vida (TTL)</th>
        <th class="px-5 py-3 font-semibold text-right">Ações</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <% if @keys.empty? %>
        <tr>
          <td colspan="4" class="px-6 py-8 text-center text-slate-400 text-sm">
            Nenhuma chave encontrada com o padrão "<%= h @pattern %>".
          </td>
        </tr>
      <% else %>
        <% @keys.each do |k| %>
          <tr class="hover:bg-slate-800/30 transition-colors">
            <td class="px-5 py-3.5">
              <a href="/keys/view?key=<%= Rack::Utils.escape(k[:name]) %>" class="font-mono text-brand-400 hover:text-brand-300 font-medium hover:underline">
                <%= h k[:name] %>
              </a>
            </td>
            <td class="px-5 py-3.5">
              <% badge_color = case k[:type]
                 when 'string' then 'bg-blue-500/10 text-blue-400 border-blue-500/20'
                 when 'hash' then 'bg-purple-500/10 text-purple-400 border-purple-500/20'
                 when 'list' then 'bg-pink-500/10 text-pink-400 border-pink-500/20'
                 when 'set' then 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                 when 'zset' then 'bg-amber-500/10 text-amber-400 border-amber-500/20'
                 else 'bg-slate-800 text-slate-400 border-slate-700'
                 end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase border <%= badge_color %>">
                <%= h k[:type] %>
              </span>
            </td>
            <td class="px-5 py-3.5 text-xs font-mono text-slate-300">
              <%= k[:ttl] == -1 ? 'Infinito (persistente)' : (k[:ttl] == -2 ? 'Expirada' : "#{k[:ttl]}s") %>
            </td>
            <td class="px-5 py-3.5 text-right space-x-2">
              <a href="/keys/view?key=<%= Rack::Utils.escape(k[:name]) %>" class="text-xs font-semibold text-slate-300 hover:text-white px-2 py-1 rounded hover:bg-slate-800">
                Ver
              </a>
              <form action="/keys/del" method="post" class="inline" onsubmit="return confirm('Confirma exclusão da chave <%= h k[:name] %>?');">
                <input type="hidden" name="key" value="<%= h k[:name] %>">
                <button type="submit" class="text-xs font-semibold text-red-400 hover:text-red-300 px-2 py-1 rounded hover:bg-red-950/30">
                  Excluir
                </button>
              </form>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
